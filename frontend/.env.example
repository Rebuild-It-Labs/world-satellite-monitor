# Where the app loads its dataset from.
# Default (unset): the bundled /data/data.json served from /public.
#
# To load from a GitHub repo instead (treated exactly like a remote API):
# VITE_DATA_URL=https://raw.githubusercontent.com/<owner>/<repo>/main/data/data.json
#
# Image URLs inside data.json are resolved against meta.assetBase unless they are absolute.
# VITE_DATA_URL=
